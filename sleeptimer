#!/usr/bin/env zsh
# sleeptimer — count down with a progress bar, then pause media, mute and put the Mac to sleep.

zmodload zsh/datetime  # provides $EPOCHSECONDS and strftime

BAR_WIDTH=${SLEEPTIMER_BAR_WIDTH:-30}
TICK=${SLEEPTIMER_TICK:-1}
MAX_SECS=86400  # 24 hours: guards against "45" meaning 45 hours when the remembered unit is h

typeset -A UNIT_SECS=(s 1 m 60 h 3600)
typeset -A UNIT_NAME=(s second m minute h hour)

# to_seconds <unit> <amount> — prints seconds; returns 1 on invalid input.
to_seconds() {
  local unit=${${(L)1}[1]} amount=$2
  [[ $amount == <1-> ]] && (( ${#amount} <= 6 )) || return 1
  case $unit in
    s) print $amount ;;
    m) print $(( amount * 60 )) ;;
    h) print $(( amount * 3600 )) ;;
    *) return 1 ;;
  esac
}

# parse_duration <text> <default-unit> — prints "<seconds> <unit>"; returns 1 on invalid input.
# Accepts "45", "45m", "1,25h", "1.5 hours", ".5h", "90 sec". Comma or dot, up to 3 decimals.
parse_duration() {
  local text=${(L)1//[[:space:]]/} unit=$2
  [[ $text =~ '^([0-9]{0,6})([.,]([0-9]{1,3}))?([a-z]*)$' ]] || return 1
  local whole=$match[1] frac=$match[3] word=$match[4]
  [[ -n $whole$frac ]] || return 1
  case $word in
    '') ;;
    s|sec|secs|second|seconds) unit=s ;;
    m|min|mins|minute|minutes) unit=m ;;
    h|hr|hrs|hour|hours) unit=h ;;
    *) return 1 ;;
  esac
  [[ $unit == [smh] ]] || return 1
  local milli=$(( 10#${whole:-0} * 1000 + 10#${(r:3::0:)frac} ))
  local secs=$(( (milli * UNIT_SECS[$unit] + 500) / 1000 ))
  (( secs >= 1 && secs <= MAX_SECS )) || return 1
  print "$secs $unit"
}

# fmt_dec <num> <den> — num/den rounded to 2 decimals, trailing zeros dropped: 4500 3600 → 1.25
fmt_dec() {
  local v=$(( ($1 * 200 + $2) / ($2 * 2) )) out
  out=$(( v / 100 )).${(l:2::0:)$(( v % 100 ))}
  out=${out%0}; out=${out%0}; out=${out%.}
  print -r -- $out
}

# plural <value> <word> — "1 hour", "1.25 hours"
plural() {
  [[ $1 == 1 ]] && print -r -- "$1 $2" || print -r -- "$1 ${2}s"
}

# describe_duration <seconds> — "3600 seconds = 60 minutes = 1 hour"; units that round to 0 are left out.
describe_duration() {
  local u v
  local -a parts
  for u in s m h; do
    v=$(fmt_dec $1 $UNIT_SECS[$u])
    [[ $v == 0 ]] || parts+=("$(plural $v $UNIT_NAME[$u])")
  done
  print -r -- ${(j: = :)parts}
}

# fmt_time <seconds> — MM:SS, or H:MM:SS for an hour or more.
fmt_time() {
  local s=$1
  if (( s >= 3600 )); then
    printf '%d:%02d:%02d' $(( s / 3600 )) $(( s % 3600 / 60 )) $(( s % 60 ))
  else
    printf '%02d:%02d' $(( s / 60 )) $(( s % 60 ))
  fi
}

# fmt_clock <epoch> [now] — "23:45" if today, "01:15 tomorrow", otherwise "Sat 14:00".
fmt_clock() {
  local t=$1 now=${2:-$EPOCHSECONDS} day today tomorrow hm
  strftime -s day '%F' $t
  strftime -s today '%F' $now
  strftime -s tomorrow '%F' $(( now + 86400 ))
  strftime -s hm '%H:%M' $t
  if [[ $day == $today ]]; then
    print -r -- $hm
  elif [[ $day == $tomorrow ]]; then
    print -r -- "$hm tomorrow"
  else
    strftime '%a %H:%M' $t
  fi
}

# render_bar <elapsed> <total> — e.g. "[#####-----]  50%  00:30 left"
render_bar() {
  local elapsed=$1 total=$2
  (( elapsed > total )) && elapsed=$total
  local pct=$(( elapsed * 100 / total ))
  local filled=$(( elapsed * BAR_WIDTH / total ))
  local bar="${(l:filled::#:)}${(l:$(( BAR_WIDTH - filled ))::-:)}"
  printf '[%s] %3d%%  %s left' "$bar" $pct "$(fmt_time $(( total - elapsed )))"
}

# ask_duration — prompt for unit then amount; prints total seconds.
ask_duration() {
  local unit amount secs label
  while true; do
    read "unit?Unit? [s/m/h]: " || return 1
    unit=${${(L)unit}[1]}
    case $unit in
      s) label=seconds ;;
      m) label=minutes ;;
      h) label=hours ;;
      *) print -u2 "Please enter s, m or h."; continue ;;
    esac
    break
  done
  while true; do
    read "amount?How many $label? " || return 1
    secs=$(to_seconds $unit $amount) && break
    print -u2 "Please enter a whole number greater than 0."
  done
  print $secs
}

# countdown <total> — redraw the bar until total seconds of wall-clock time pass.
countdown() {
  local total=$1 start=$EPOCHSECONDS elapsed=0
  while (( elapsed < total )); do
    printf '\r%s\e[K' "$(render_bar $elapsed $total)"
    sleep $TICK
    elapsed=$(( EPOCHSECONDS - start ))
  done
  printf '\r%s\e[K\n' "$(render_bar $total $total)"
}

# pause_media — pause whatever is "Now Playing" (needs `brew install media-control`).
# Never fails: a missing tool or nothing playing must not stop the Mac sleeping.
pause_media() {
  if (( ! $+commands[media-control] )); then
    print -u2 "Tip: brew install media-control to also pause music and videos."
    return 0
  fi
  media-control pause 2>/dev/null
  return 0
}

go_to_sleep() {
  if [[ -n $SLEEPTIMER_DRY_RUN ]]; then
    print "DRY RUN: pause + mute + sleep"
    return
  fi
  pause_media
  osascript -e "set volume with output muted" && pmset sleepnow
}

main() {
  trap 'print "\nCancelled — not sleeping."; exit 130' INT
  local secs
  secs=$(ask_duration) || { print; exit 1 }
  print "Sleeping in $(fmt_time $secs). Ctrl+C to cancel."
  countdown $secs
  go_to_sleep
}

[[ $ZSH_EVAL_CONTEXT == toplevel ]] && main "$@"
